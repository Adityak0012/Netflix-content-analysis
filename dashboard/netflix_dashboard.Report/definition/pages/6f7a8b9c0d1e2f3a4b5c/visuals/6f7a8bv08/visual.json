                      "fontSize": "15pt",
                      "color": "#FFFFFF",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "•  Model: Titles fact table with genre and country bridge tables (a title can have several), filtering in both directions; 21 DAX measures.",
                    "textStyle": {
                      "fontSize": "15pt",
                      "color": "#FFFFFF",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "•  Limitations: shows what is available on Netflix, not what people watch; country and director are missing for some titles.",
                    "textStyle": {
                      "fontSize": "15pt",
                      "color": "#FFFFFF",
